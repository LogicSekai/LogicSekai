{
  "name": "logic-sekai",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:production": "NODE_ENV=production nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate --config=drizzle.dev.config.ts",
    "db:generate:prod": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.dev.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push:prod": "wrangler d1 migrations apply logic-sekai-db --remote",
    "db:studio": "drizzle-kit studio --config=drizzle.dev.config.ts",
    "db:studio:prod": "drizzle-kit studio --config=drizzle.config.ts",
    "db:seed": "node scripts/seed-data.js",
    "deploy": "wrangler pages deploy .output/public",
    "deploy:build": "bun run build:production && wrangler pages deploy .output/public"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20251107.0",
    "@paralleldrive/cuid2": "^3.0.4",
    "@tailwindcss/vite": "^4.1.17",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-text-align": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "@types/bcryptjs": "^3.0.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.553.0",
    "nuxt": "^4.2.1",
    "reka-ui": "^2.6.0",
    "shadcn-nuxt": "2.3.2",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "wrangler": "^4.46.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "better-sqlite3": "^12.4.1",
    "typescript": "^5.9.3"
  }
}
