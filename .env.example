# Environment
NODE_ENV=development

# Database Configuration (Production - Cloudflare D1)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_DATABASE_ID=your_database_id  
CLOUDFLARE_API_TOKEN=your_api_token

# Development Database
DATABASE_URL=file:./dev.db

# Authentication
BETTER_AUTH_SECRET=your-super-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Superadmin Setup  
SUPERADMIN_SETUP_SECRET=your-superadmin-setup-secret-key

# Cloudflare Pages (Production)
# BETTER_AUTH_URL=https://your-domain.pages.dev