# ---------------------------------------------
# Environment
# ---------------------------------------------
NODE_ENV=development

# ---------------------------------------------
# Authentication
# ---------------------------------------------
# URL dasar situs (redirect pembayaran, sitemap, dll.). Nama variabel dipertahankan demi
# kompatibilitas — better-auth sudah tidak dipakai; sesi login ada di tabel user_sessions.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------
# Superadmin Setup
# ---------------------------------------------
# Minimal 16 karakter. Kosong = endpoint /api/setup/superadmin nonaktif.
# Endpoint juga otomatis terkunci setelah superadmin pertama dibuat.
SUPERADMIN_SETUP_SECRET=

# ---------------------------------------------
# Cloudflare D1 (untuk production & drizzle push)
# ---------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_DATABASE_ID=your_database_id
CLOUDFLARE_API_TOKEN=your_api_token

# ---------------------------------------------
# Payment Gateway — Credential Encryption
# ---------------------------------------------
# AES-256-GCM master key (32 bytes, base64-encoded).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In Cloudflare production: wrangler secret put ENCRYPTION_MASTER_KEY
ENCRYPTION_MASTER_KEY=your-32-byte-base64-key-here

# Key rotation: when rotating, add the new key as V2, V3, etc.
# Keep old versions until all rows have been re-encrypted via /api/creator/payment-gateway/rotate-key
# ENCRYPTION_MASTER_KEY_V2=your-new-32-byte-base64-key-here

# ---------------------------------------------
# Midtrans — Platform-Level Donation Account
# ---------------------------------------------
# Mode: 'sandbox' for testing, 'live' for production
MIDTRANS_MODE=sandbox

# Midtrans Sandbox keys (from https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# Midtrans Production keys (from https://dashboard.midtrans.com)
# MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------
# Observability (Fase 2) — opsional
# ---------------------------------------------
# Teruskan error klien ke webhook eksternal (Sentry/GlitchTip/Discord). Kosongkan untuk hanya log Workers.
ERROR_WEBHOOK_URL=
# Cloudflare Web Analytics beacon token (gratis, tanpa cookie). Ambil dari dashboard Cloudflare > Web Analytics.
NUXT_PUBLIC_CF_BEACON_TOKEN=
