# ---------------------------------------------
# Environment
# ---------------------------------------------
NODE_ENV=development

# ---------------------------------------------
# Authentication
# ---------------------------------------------
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-change-in-production
BETTER_AUTH_URL=http://localhost:3001

# ---------------------------------------------
# Superadmin Setup
# ---------------------------------------------
SUPERADMIN_SETUP_SECRET=your-superadmin-setup-secret-key

# ---------------------------------------------
# Cloudflare D1 (untuk production & drizzle push)
# ---------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_DATABASE_ID=your_database_id
CLOUDFLARE_API_TOKEN=your_api_token

# ---------------------------------------------
# Payment Gateway — Credential Encryption
# ---------------------------------------------
# AES-256-GCM master key (32 bytes, base64-encoded).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In Cloudflare production: wrangler secret put ENCRYPTION_MASTER_KEY
ENCRYPTION_MASTER_KEY=your-32-byte-base64-key-here

# Key rotation: when rotating, add the new key as V2, V3, etc.
# Keep old versions until all rows have been re-encrypted via /api/creator/payment-gateway/rotate-key
# ENCRYPTION_MASTER_KEY_V2=your-new-32-byte-base64-key-here
